INFOMANCER_DATABASE=data/infomancer.db
# Docker Linux builds run the application as this non-root UID/GID. Set these
# to the host account that owns data/ and any media folders InfoMancer may edit.
INFOMANCER_UID=1000
INFOMANCER_GID=1000
# Strongly recommended for long-lived installations and any remote/Cloudflare
# deployment. Keep this long random secret outside the InfoMancer data folder.
# When left blank, InfoMancer creates and retains a local encryption key beside
# its data; Settings warns when remote access is configured without this value.
INFOMANCER_SECRET=
# Optional first-run override. When blank, InfoMancer generates a one-time
# bootstrap token and prints it to the server logs until setup finishes.
INFOMANCER_BOOTSTRAP_TOKEN=
# Authentication modes: local, cloudflare, or disabled. Disabled is intended
# only for an explicitly trusted loopback/private installation.
INFOMANCER_AUTH_MODE=local
INFOMANCER_SESSION_DAYS=14
INFOMANCER_COOKIE_SECURE=auto
# Recommended for any reverse-proxied installation. Used for Secure-cookie
# decisions, generated invitation links, and Host validation.
INFOMANCER_PUBLIC_URL=
# Optional comma-separated exact hostnames accepted by the web app. Localhost
# and loopback remain accepted for health checks and local administration.
INFOMANCER_TRUSTED_HOSTS=
# Set true only when the origin is private and all non-loopback traffic reaches
# InfoMancer through Cloudflare. This allows CF-Connecting-IP and forwarded
# HTTPS metadata to be trusted even when InfoMancer itself uses local accounts.
INFOMANCER_TRUST_CLOUDFLARE_PROXY=false
# Required only when INFOMANCER_AUTH_MODE=cloudflare.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
TVDB_API_KEY=
TVDB_PIN=
# A search URL only. InfoMancer never starts a download.
SEARCH_URL_TEMPLATE=https://ext.to/browse/?q={query}
# Comma-separated paths visible to InfoMancer. Docker installations normally
# keep /media and map each host folder beneath it in compose.media.yaml.
MEDIA_BROWSE_ROOTS=/media
