# SQLite catalogs and sidecar files are runtime/local state, never repository source.
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal

!.env.sandbox.example
*.log
*.tar.gz
dist/
build/
*.spec
im_jobs.json

# Desktop build output and dependency caches are reproducible and must not be committed.
node_modules/
desktop/src-tauri/target/
desktop/src-tauri/binaries/infomancer-core-*

# Generated product screenshots are local posting assets, not repository source.
showcase/screenshots/

# Operating-system metadata is never part of an InfoMancer build.
.DS_Store
Thumbs.db
Desktop.ini

# Graft's local graph cache and query snapshots are regenerable, not repository source.
graft/
.graft-*.txt
