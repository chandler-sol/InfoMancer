{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InfoMancer",
  "version": "0.8.1-beta.2",
  "identifier": "cloud.arsenik.infomancer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": [
        "launcher"
      ],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Arsenik",
    "homepage": "https://infomancer.media/",
    "category": "Utility",
    "shortDescription": "Self-hosted media catalog and library intelligence",
    "longDescription": "InfoMancer is a native desktop client and local workspace for cataloging, matching, inspecting, and organizing movie and TV libraries.",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/infomancer-core"
    ],
    "linux": {
      "appimage": {
        "files": {
          "/usr/share/metainfo/cloud.arsenik.infomancer.metainfo.xml": "linux/cloud.arsenik.infomancer.metainfo.xml"
        }
      },
      "deb": {
        "desktopTemplate": "linux/InfoMancer.desktop.hbs",
        "files": {
          "/usr/share/metainfo/cloud.arsenik.infomancer.metainfo.xml": "linux/cloud.arsenik.infomancer.metainfo.xml"
        }
      }
    },
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh",
        "languages": [
          "English"
        ],
        "customLanguageFiles": {
          "English": "./windows/English.nsh"
        },
        "startMenuFolder": "InfoMancer"
      }
    }
  }
}
