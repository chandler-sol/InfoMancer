{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infomancer.media/schemas/update-channel-manifest-v1.json",
  "title": "InfoMancer Update Channel Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "channel",
    "version",
    "build_id",
    "commit_sha",
    "qualified_at",
    "qualification",
    "database_schema",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "channel": {"enum": ["standard", "beta", "dev"]},
    "version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "build_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "qualified_at": {"type": "string", "format": "date-time"},
    "release_notes_url": {"type": "string", "format": "uri"},
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "workflow", "run_id", "gates"],
      "properties": {
        "status": {"const": "passed"},
        "workflow": {"type": "string", "minLength": 1},
        "run_id": {"type": "integer", "minimum": 1},
        "run_url": {"type": "string", "format": "uri"},
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "database_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current",
        "minimum_reader_schema",
        "minimum_writer_schema",
        "downgrade_policy"
      ],
      "properties": {
        "current": {"type": "integer", "minimum": 1},
        "minimum_reader_schema": {"type": "integer", "minimum": 1},
        "minimum_writer_schema": {
          "anyOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "downgrade_policy": {
          "enum": ["compatible", "read_only", "restore_required"]
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "url", "sha256"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "signature": {"type": "string", "minLength": 1},
          "tag": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
